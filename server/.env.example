# ZYRO STORE - Backend Server
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/zyro_store

# Session Secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-super-secret-session-key-change-this

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-jwt-secret-key-change-this

# Litecoin Configuration
LTC_RPC_HOST=127.0.0.1
LTC_RPC_PORT=9332
LTC_RPC_USER=your-ltc-rpc-username
LTC_RPC_PASSWORD=your-ltc-rpc-password
LTC_REQUIRED_CONFIRMATIONS=3
LTC_PAYMENT_TIMEOUT_MINUTES=30

# Litecoin Wallet (NEVER expose private keys)
LTC_WALLET_NAME=zyro_store_wallet
# Private keys are managed by Litecoin Core, never stored here

# Minecraft Bot Configuration
MC_SERVER_HOST=mc.yourserver.com
MC_SERVER_PORT=25565
MC_BOT_USERNAME=ZyroDeliveryBot
MC_BOT_PASSWORD=  # Leave empty for offline/cracked servers
MC_DELIVERY_COMMAND=/give {player} diamond {amount}
MC_RECONNECT_INTERVAL_MS=5000
MC_MAX_RECONNECT_ATTEMPTS=10

# Email Configuration (for verification & password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@zyrostore.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin
ADMIN_DEFAULT_EMAIL=admin@zyrostore.com
ADMIN_DEFAULT_PASSWORD=change-this-immediately
