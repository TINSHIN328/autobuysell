// This is the Prisma schema for the ZYRO STORE database
// Run `npx prisma generate` to generate the client
// Run `npx prisma migrate dev` to create migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  username          String    @unique
  email             String    @unique
  passwordHash      String
  role              Role      @default(CUSTOMER)
  isBanned          Boolean   @default(false)
  emailVerified     Boolean   @default(false)
  minecraftUsername String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions          Session[]
  orders            Order[]
  tickets           SupportTicket[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([username])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  description    String
  priceLTC       Decimal  @db.Decimal(18, 8)
  deliveryAmount String
  image          String   @default("💰")
  category       String
  inStock        Boolean  @default(true)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  orders Order[]

  @@index([category])
  @@index([enabled])
  @@map("products")
}

model Order {
  id                    String      @id @default(uuid())
  userId                String
  productId             String
  minecraftUsername     String
  ltcAmount             Decimal     @db.Decimal(18, 8)
  paymentAddress        String
  transactionId         String?     @unique
  status                OrderStatus @default(PENDING_PAYMENT)
  confirmations         Int         @default(0)
  requiredConfirmations Int         @default(3)
  createdAt             DateTime    @default(now())
  paidAt                DateTime?
  completedAt           DateTime?
  expiresAt             DateTime

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  payments        Payment[]
  deliveryQueue   DeliveryQueue?
  deliveryLogs    DeliveryLog[]

  @@index([userId])
  @@index([status])
  @@index([paymentAddress])
  @@index([transactionId])
  @@index([expiresAt])
  @@map("orders")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  address       String
  amount        Decimal       @db.Decimal(18, 8)
  transactionId String?       @unique
  confirmations Int           @default(0)
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  confirmedAt   DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([address])
  @@index([transactionId])
  @@index([status])
  @@map("payments")
}

model DeliveryQueue {
  id        String   @id @default(uuid())
  orderId   String   @unique
  priority  Int      @default(0)
  attempts  Int      @default(0)
  maxRetry  Int      @default(3)
  status    QueueStatus @default(WAITING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([priority])
  @@map("delivery_queue")
}

model DeliveryLog {
  id        String   @id @default(uuid())
  orderId   String
  action    String
  message   String
  success   Boolean
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("delivery_logs")
}

model SupportTicket {
  id          String        @id @default(uuid())
  userId      String
  subject     String
  description String
  orderId     String?
  status      TicketStatus  @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  content   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model Setting {
  key   String @id
  value String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_CONFIRMATIONS
  PAID
  QUEUED
  DELIVERING
  COMPLETED
  DELIVERY_FAILED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum QueueStatus {
  WAITING
  PROCESSING
  COMPLETED
  FAILED
}

enum TicketStatus {
  OPEN
  CLOSED
}
